{
  "name": "maze-bank-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npx.cmd ng serve",
  "start:backend": "node backend/index.js",
  "start:dev": "concurrently \"npx.cmd ng serve --proxy-config proxy.conf.json\" \"node backend/index.js\"",
    "build": "ng build",
  "serve-dist": "npx.cmd ng build --configuration production && npx.cmd http-server ./dist/MazeBankProject -p 4201 -c-1",
  "serve-dist-express": "npx.cmd ng build --configuration production && node scripts/copy-index-to-indexhtml.js && node tools/serve-browser.js -p 4201",
  "start:frontend-auto": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\ensure-front-4201.ps1 -KillExisting",
  "start:front-dev": "node tools/serve-browser.js -p 4201",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:MazeBankProject": "node dist/MazeBankProject/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-server": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@angular/ssr": "^20.2.2",
    "express": "^5.1.0",
    "dotenv": "^16.3.1",
    "minimist": "^1.2.8",
    "http-proxy-middleware": "^2.0.6",
  "better-sqlite3": "^8.5.0",
    "jsonwebtoken": "^9.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.4",
    "@types/express": "^5.0.1",
    "concurrently": "^8.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "zone.js": "^0.15.1"
  }
}
